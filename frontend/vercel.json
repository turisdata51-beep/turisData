{
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "rewrites": [
        {
            "source": "/api/:ruta*",
            "destination": "https://turisdata.onrender.com/api/:ruta*"
        },
        {
            "source": "/((?!assets/).*)",
            "destination": "/index.html"
        }
    ]
}